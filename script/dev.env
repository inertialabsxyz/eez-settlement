# Endpoints, keys and parameters for the `eez-dev` Kurtosis enclave.
#
#     set -a; source script/dev.env; set +a
#
# Every key here is a public, deterministic private-network key from
# `eez-rollup0/testing/kurtosis/ci-args.yaml`. They are worthless and must never
# be funded on a public chain.
#
# Port lookups shell out to `kurtosis` on every source, which takes a couple of
# seconds. That is deliberate: the enclave republishes ports on every restart,
# and a cached endpoint file is the most common way to spend an hour debugging a
# devnet that moved.

KURTOSIS_ENCLAVE=${KURTOSIS_ENCLAVE:-eez-dev}

L1_RPC=http://$(kurtosis port print "$KURTOSIS_ENCLAVE" el-1-reth-lighthouse rpc)
L2_RPC=$(kurtosis port print "$KURTOSIS_ENCLAVE" eez-node l2-rpc)

# The cross-chain fronts. `L2_FRONT` accepts outbound L2->L1 raw transactions and
# is the ONLY endpoint a settlement reveal may be sent to: a reveal sent to
# L2_RPC lands in an ordinary live block, where the L1 proxy rejects it with
# `ExecutionNotInCurrentBlock`. See docs note (4) in the harness README.
L2_FRONT=$(kurtosis port print "$KURTOSIS_ENCLAVE" eez-node l2-xchain)
L1_FRONT=$(kurtosis port print "$KURTOSIS_ENCLAVE" eez-node l1-xchain)

# The EEZ system contracts. `EEZ_ROLLUP_ID` is this L2's id as L1 sees it;
# `EEZ_L1_ROLLUP_ID` is L1's id as L2 sees it. Executor takes the first, Book the
# second, and swapping them yields a proxy address that exists but never calls.
EEZL2_ADDRESS=0x4200000000000000000000000000000000000007
EEZ_REGISTRY_ADDRESS=0x5fbdb2315678afecb367f032d93f642f64180aa3
EEZ_ROLLUP_ID=1
EEZ_L1_ROLLUP_ID=0

L1_CHAIN_ID=$(cast chain-id --rpc-url "$L1_RPC")
L2_CHAIN_ID=$(cast chain-id --rpc-url "$L2_RPC")

# ---------------------------------------------------------------------------
# Accounts
# ---------------------------------------------------------------------------
# Anvil index 2. Prefunded on L1 and in L2 genesis; deploys everything and is the
# admin of both `Executor` and `Book`.
DEPLOYER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
DEPLOYER=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC

# Anvil 3, 4, 5. Prefunded in L2 genesis only, so install-l1.sh tops up their L1
# balance for the one L1 transaction each trader makes (the Relayer approval).
ALICE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
ALICE=0x90F79bf6EB2c4f870365E785982E1f101E93b906
BOB_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
BOB=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
SOLVER_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
SOLVER=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc

# ---------------------------------------------------------------------------
# §13.2 is OPEN. This is not an answer to it.
# ---------------------------------------------------------------------------
# `Executor`'s constructor requires a non-zero `windfallRecipient`, so a devnet
# deployment cannot avoid passing something. This address was chosen to be
# obviously fake and to belong to nobody in this harness -- not the deployer, not
# a trader, not the solver -- so that a residue sweep into it is visible in a
# balance assertion (I17) and so that nothing here reads as a decision.
#
# §13.2 asks who the real recipient should be. It is still unanswered, and
# CLAUDE.md forbids answering it by picking a value. Do not promote this address
# out of this file.
WINDFALL_RECIPIENT_DEVNET_PLACEHOLDER=0x00000000000000000000000000000000DeaDFee5

export KURTOSIS_ENCLAVE L1_RPC L2_RPC L1_FRONT L2_FRONT
export EEZL2_ADDRESS EEZ_REGISTRY_ADDRESS EEZ_ROLLUP_ID EEZ_L1_ROLLUP_ID
export L1_CHAIN_ID L2_CHAIN_ID
export DEPLOYER_KEY DEPLOYER ALICE_KEY ALICE BOB_KEY BOB SOLVER_KEY SOLVER
export WINDFALL_RECIPIENT_DEVNET_PLACEHOLDER
